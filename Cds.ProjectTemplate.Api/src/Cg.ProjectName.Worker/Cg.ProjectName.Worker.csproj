<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hangfire.EntityFrameworkCore e Hangfire.MemoryStorage foram removidos
         daqui: nada no projeto os usa. O storage real (UseSqlServerStorage)
         vem do próprio pacote "Hangfire" (que já traz Hangfire.SqlServer
         embutido), configurado centralmente em
         Ioc/Configurations/HangfireConfiguration.cs — não há storage
         alternativo (EF Core ou em memória) configurado em lugar nenhum. -->
    <PackageReference Include="Hangfire" Version="1.8.25" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.CrossCutting.Ioc\Cg.ProjectName.Infrastructure.CrossCutting.Ioc.csproj" />
    <!-- Referenciado diretamente (não só transitivamente via Ioc) porque
         DemoEmployeeCreatedIntegrationEventConsumer usa IConsumer<T> do
         MassTransit, e Program.cs usa AddConsumer<T>/IBusRegistrationConfigurator
         — mesma convenção do resto da solução: referencie explicitamente o
         que seu próprio código usa diretamente. Traz o pacote MassTransit
         (mas não MassTransit.RabbitMQ, que é exclusivo de quem configura o
         transporte) transitivamente. -->
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.CrossCutting.Messaging\Cg.ProjectName.Infrastructure.CrossCutting.Messaging.csproj" />
    <!-- Referenciado diretamente pelo mesmo motivo acima: Program.cs nomeia
         CgProjectNameDbContext diretamente (como argumento de tipo genérico
         de AddRabbitMqConfiguration<TDbContext>) — já vinha disponível
         transitivamente via Ioc, mas o código deste projeto o usa por nome,
         então ganha a referência explícita. -->
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.Data\Cg.ProjectName.Infrastructure.Data.csproj" />
  </ItemGroup>

</Project>
