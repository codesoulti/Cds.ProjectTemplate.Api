<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.8.25" />
    <PackageReference Include="Hangfire.EntityFrameworkCore" Version="0.9.0" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.CrossCutting.Ioc\Cg.ProjectName.Infrastructure.CrossCutting.Ioc.csproj" />
    <!-- Referenciado diretamente (não só transitivamente via Ioc) porque
         DemoEmployeeCreatedIntegrationEventConsumer usa IConsumer<T> do
         MassTransit, e Program.cs usa AddConsumer<T>/IBusRegistrationConfigurator
         — mesma convenção do resto da solução: referencie explicitamente o
         que seu próprio código usa diretamente. Traz o pacote MassTransit
         (mas não MassTransit.RabbitMQ, que é exclusivo de quem configura o
         transporte) transitivamente. -->
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.CrossCutting.Messaging\Cg.ProjectName.Infrastructure.CrossCutting.Messaging.csproj" />
  </ItemGroup>

</Project>
