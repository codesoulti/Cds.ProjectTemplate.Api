<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sem isso, os comentários /// dos controllers/DTOs nunca chegavam ao
         Swagger — IncludeXmlComments (ver SwaggerConfiguration) depende de
         um arquivo .xml gerado no build para existir. CS1591 (aviso de
         "membro público sem comentário XML") é suprimido porque nem todo
         tipo público deste projeto tem documentação formal ainda; isso não
         afeta os comentários que já existem, só evita centenas de warnings
         de build para os que faltam. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Referenciados explicitamente (em vez de depender apenas do fluxo
         transitivo via Ioc -> Infrastructure.Data) porque ValidationExceptionMiddleware
         trata DbUpdateException/SqlException diretamente. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cg.ProjectName.Infrastructure.CrossCutting.Ioc\Cg.ProjectName.Infrastructure.CrossCutting.Ioc.csproj" />
  </ItemGroup>

</Project>
