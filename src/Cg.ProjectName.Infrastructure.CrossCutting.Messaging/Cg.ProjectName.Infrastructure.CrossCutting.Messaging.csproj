<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cg.ProjectName.Infrastructure.CrossCutting.Messaging</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Confirme em https://www.nuget.org/packages/MassTransit se esta é
         realmente a versão mais recente antes do primeiro restore real: o
         ambiente usado para criar este projeto não teve acesso ao NuGet.org
         para validar isso, e o número abaixo pode já estar desatualizado. -->
    <PackageReference Include="MassTransit" Version="8.3.4" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.4" />
    <!-- Outbox Transacional (AddEntityFrameworkOutbox, usado por
         RabbitMqConfiguration quando useOutbox: true). Mesmo aviso de versão
         do MassTransit acima: confira no NuGet.org antes do primeiro
         restore real. -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.3.4" />
    <!-- Referenciado explicitamente porque RabbitMqConfiguration usa DbContext
         como restrição genérica (where TDbContext : DbContext) — sem ganhar
         uma ProjectReference para Infrastructure.Data por causa disso (ver
         comentário em RabbitMqConfiguration). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cg.ProjectName.Application\Cg.ProjectName.Application.csproj" />
  </ItemGroup>

</Project>
